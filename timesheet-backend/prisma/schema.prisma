generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model timesheet {
  id           Int      @id @default(autoincrement())
  userId       Int
  date         DateTime
  checkInTime  DateTime
  checkOutTime DateTime
  activity     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "TimeSheet_userId_fkey")

  @@index([userId], map: "TimeSheet_userId_fkey")
}

model user {
  id                  Int             @id @default(autoincrement())
  studentId           String          @unique(map: "User_studentId_key")
  fullName            String
  passwordHash        String
  role                user_role       @default(student)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  email               String?         @db.VarChar(255)
  phone               String?         @db.VarChar(20)

  course              String?         @db.VarChar(50)  // หลักสูตร
  branch              String?         @db.VarChar(50)  // สาขา
  semester            String?         @db.VarChar(20)  // ภาคการศึกษา
  academicYear        String?         @db.VarChar(10)  // ปีการศึกษา
  companyName         String?         @db.VarChar(255) // ชื่อสถานประกอบการ
  internPosition      String?         @db.VarChar(255) 
  profileImage        String?         @db.VarChar(255) // URL หรือ path รูปโปรไฟล์
  passwordResetToken  String?         @unique
  passwordResetExpires DateTime?

  timesheet           timesheet[]
  documentScans       document_scan[] // ✅ ความสัมพันธ์ไปยังตารางเก็บประวัติการสแกนเอกสาร
}

// ✅ เพิ่ม Model สำหรับเก็บข้อมูลเอกสารที่อัปโหลดและผลการสแกน OCR
model document_scan {
  id            Int        @id @default(autoincrement())
  userId        Int
  docCategory   String     @db.VarChar(100) // ประเภทเอกสาร เช่น ใบสมัครสหกิจนักศึกษา, ใบรับรองแพทย์
  fileUrl       String     @db.VarChar(255) // Path หรือ URL ของไฟล์ภาพที่อัปโหลด
  extractedText String?    @db.Text         // ข้อความที่สแกนอ่านได้จากภาพ (OCR)
  extractedData Json?                       // 👈 เพิ่มฟิลด์นี้สำหรับเก็บข้อมูล JSON ที่ parse ได้
  status        doc_status @default(pending) // สถานะการตรวจสอบ
  remark        String?    @db.Text         // หมายเหตุจาก admin/อาจารย์ตอนตรวจสอบ (เช่น เหตุผลที่ไม่ผ่าน)
  reviewedBy    Int?                        // userId ของ admin/อาจารย์ที่ตรวจ (ถ้ามี)
  reviewedAt    DateTime?                   // เวลาที่ตรวจสอบล่าสุด
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          user       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ✅ Enum สำหรับสถานะการตรวจสอบเอกสาร
enum doc_status {
  pending
  passed
  failed
}

enum user_role {
  admin
  student
  teacher
}